 3 files changed, 93 insertions(+), 72 deletions(-)

diff --git a/docs/sphinx/api/default_ops.rst b/docs/sphinx/api/default_ops.rst
index 48e2997..7928c2f 100644
--- a/docs/sphinx/api/default_ops.rst
+++ b/docs/sphinx/api/default_ops.rst
@@ -696,21 +696,21 @@ operations, each operating on 2 qubits.
       :end-before: [End Docs]
 
 
-Whether a whole :code:`qvector` can supply the targets of a custom operation
-differs between Python and C++.
+The target qubits of a custom operation with more than one target are passed
+individually, as positional arguments, in both Python and C++.
 
 .. tab:: Python
 
-    The target qubits of a custom operation can be passed individually, as a
-    whole :code:`qvector`, or as a combination of both. The total number of
-    qubits passed must equal the number of targets of the operation.
+    Each target qubit of a multi-qubit custom operation must be passed as its
+    own argument. A :code:`qvector` cannot supply the targets, whether passed
+    whole or unpacked with :code:`*`; either form is a compile-time error.
 
     .. code-block:: python
 
         qubits = cudaq.qvector(2)
-        my_cnot(qubits[0], qubits[1])
-        my_cnot(qubits)   # equivalent to the line above
-        my_cnot(*qubits)  # equivalent to the line above
+        my_cnot(qubits[0], qubits[1])  # supported
+        # my_cnot(qubits)              # error
+        # my_cnot(*qubits)             # error
 
 .. tab:: C++
 
diff --git a/python/cudaq/kernel/ast_bridge.py b/python/cudaq/kernel/ast_bridge.py
index 9b350fb..dcd400d 100644
--- a/python/cudaq/kernel/ast_bridge.py
+++ b/python/cudaq/kernel/ast_bridge.py
@@ -2586,9 +2586,37 @@ class PyASTBridge(ast.NodeVisitor):
         return None
 
     def __expandCustomOpTargets(self, pyArgs, numTargets, node):
-        """Collect qubit references for a custom operation call, expanding `qvector`
-        arguments into individual references.
+        """Collect qubit references for a custom operation call. An operation
+        with more than one target takes each target as its own positional
+        argument; only a single-target operation accepts a `qvector`.
         """
+        if numTargets > 1:
+            opName = node.func.id
+            targets = []
+            for arg in pyArgs:
+                if isinstance(arg, ast.Starred):
+                    self.emitFatalError(
+                        f'custom operation {opName} has {numTargets} targets; '
+                        'pass each target qubit individually instead of '
+                        'unpacking a qvector', node)
+                self.visit(arg)
+                val = self.popValue()
+                if quake.VeqType.isinstance(val.type):
+                    self.emitFatalError(
+                        f'custom operation {opName} has {numTargets} targets; '
+                        'pass each target qubit individually, a qvector '
+                        'cannot supply them', node)
+                if not quake.RefType.isinstance(val.type):
+                    self.emitFatalError(
+                        'invalid target operand for custom operation: '
+                        'expected a qubit', node)
+                targets.append(val)
+            if len(targets) != numTargets:
+                self.emitFatalError(
+                    f'custom operation requires {numTargets} qubit target(s), '
+                    f'but {len(targets)} were provided', node)
+            return targets
+
         # Pass 1: Compute the static qubit count
         values = []
         staticCount = 0
