+                                [],
+                                matrix=FlatSymbolRefAttr.get(globalName),
+                                parameters=[],
+                                controls=[],
+                                targets=[q],
+                                is_adj=isAdj)
+
+                        veqSize = quake.VeqSizeOp(self.getIntegerType(),
+                                                  val).result
