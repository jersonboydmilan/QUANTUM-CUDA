         //             | exp(iφ) * sin(θ/2)   exp(i(λ + φ)) * cos(θ/2) |
         u3(M_PI, M_PI, M_PI_2, q);
 
+:code:`exp_pauli`
+---------------------
+
+This operation applies a rotation generated by a Pauli tensor product,
+:math:`\exp(i \theta P)`, where :math:`P` is given as a Pauli word such as
+:code:`"XY"`. The Pauli characters are matched to the target qubits in order,
+so the length of the Pauli word must equal the number of target qubits. The
+word may contain :code:`"I"` characters, which leave the corresponding qubit
+unchanged.
+
+.. tab:: Python
+
+    .. code-block:: python
+
+        qubits = cudaq.qvector(2)
+        theta = 0.5
+
+        # Apply the unitary transformation
+        # exp(i * theta * X(0) Y(1))
+        exp_pauli(theta, qubits, "XY")
+
+        # The targets may also be listed individually, in which case the
+        # Pauli word precedes them.
+        exp_pauli(theta, "XY", qubits[0], qubits[1])
+
+.. tab:: C++
+
+    .. code-block:: cpp
+
+        cudaq::qvector qubits(2);
+        double theta = 0.5;
+
+        // Apply the unitary transformation
+        // exp(i * theta * X(0) Y(1))
+        exp_pauli(theta, qubits, "XY");
+
+        // The targets may also be listed individually, in which case the
+        // Pauli word precedes them.
+        exp_pauli(theta, "XY", qubits[0], qubits[1]);
+
 
 Adjoint and Controlled Operations
 ==================================
